        ],
        "supportedReasoningEfforts": [
          "effort01", "effort02", "effort03", "effort04", "effort05", "effort06", "effort07", "effort08",
          "effort09", "effort10", "effort11", "effort12", "effort13", "effort14", "effort15", "effort16",
          "effort17", "effort18", "effort19", "effort20", "effort21", "effort22", "effort23", "effort24",
          "effort25", "effort26", "effort27", "effort28", "effort29", "effort30", "effort31", "effort32", "low"
