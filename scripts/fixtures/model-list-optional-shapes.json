        "supportedContextTiers": null,
        "supportedReasoningEfforts": null,
        "defaultReasoningEffort": null,
        "capabilities": { "supports": { "reasoning_effort": null } }
      },
      "expected": { "contextTiers": ["default"], "reasoningEfforts": [] }
    },
    {
      "name": "non-array-options",
